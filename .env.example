# ============================================================================
# Everest — environment configuration
# ============================================================================
# There are TWO separate env files. This matters: Vite only reads env files
# from the FRONTEND project root, and only exposes VITE_-prefixed variables to
# the browser bundle. A frontend variable placed in backend/.env is silently
# ignored — no error, it simply never loads.
#
#   backend/.env    server-side secrets. NEVER exposed to the browser.
#   frontend/.env   browser-visible values. Publishable keys only.
#
# Copy the relevant block into each file and fill in your own values.
# ============================================================================


# ---------------------------------------------------------------------------
# backend/.env
# ---------------------------------------------------------------------------

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/everest

# Signs the JWTs issued at login. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string

# --- Market data: quotes (REQUIRED) ----------------------------------------
# Live quotes, company profiles and fundamentals.
# Free tier at https://finnhub.io — 60 calls/minute.
# NOTE: the free tier does NOT include historical candles; see below.
FINNHUB_API_KEY=your-finnhub-key

# --- Market data: historical candles (OPTIONAL) ----------------------------
# Powers the Stock Detail chart, the Dashboard performance chart and watchlist
# sparklines. Without it those render an empty state; everything else works.
# Free tier at https://twelvedata.com — 800 credits/day, 8 requests/minute.
TWELVEDATA_API_KEY=your-twelvedata-key

# --- News (OPTIONAL) -------------------------------------------------------
# Company headlines on the Stock Detail page.
# The vendor is auto-detected from the key's shape:
#   keys starting "pub_"    -> newsdata.io   (https://newsdata.io)
#   bare 32-char hex        -> newsapi.org   (https://newsapi.org)
# Set NEWS_PROVIDER to "newsdata" or "newsapi" to override auto-detection.
NEWS_API_KEY=your-news-key
# NEWS_PROVIDER=newsdata

# --- AI research tools (OPTIONAL) ------------------------------------------
# Powers the six tools in the AI workspace.
GEMINI_API_KEY=your-gemini-key


# ---------------------------------------------------------------------------
# frontend/.env
# ---------------------------------------------------------------------------
# ONLY VITE_-prefixed variables reach the browser. Never put a server secret
# here — it is compiled into the JavaScript bundle and is publicly readable.

# Company logos. This is a PUBLISHABLE key (pk_...), designed for client-side
# use. Free tier at https://logo.dev
# Without it, Everest falls back to its brand-coloured monogram marks.
VITE_LOGO_TOKEN=pk_your-logo-dev-token
